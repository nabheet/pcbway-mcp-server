{
  "name": "pcbway-mcp-server",
  "version": "0.1.1",
  "description": "PCBWay MCP server for AI coding assistants — PCBWay API tools for instant PCB manufacturing quotes, SMT assembly pricing, order management, and shipping costs.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pcbway-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\" \"#node_modules/**\" \"#dist/**\" \"#.git/**\"",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\" \"#node_modules/**\" \"#dist/**\" \"#.git/**\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pcbway",
    "mcp",
    "model context protocol",
    "pcbway api",
    "pcb quote",
    "smt assembly",
    "pcb",
    "pcba",
    "manufacturing",
    "electronics",
    "hardware",
    "pcb assembly",
    "pcb manufacturing",
    "prototyping",
    "supply chain"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabheet/pcbway-mcp-server.git"
  },
  "homepage": "https://github.com/nabheet/pcbway-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/nabheet/pcbway-mcp-server/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "author": "Nabheet S. Sandhu",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "katex": "^0.19.1",
    "re2js": "2.8.7"
  }
}
