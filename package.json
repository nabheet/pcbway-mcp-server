{
  "name": "pcbway-mcp-server",
  "version": "0.1.1",
  "description": "PCBWay MCP server for AI coding assistants — PCBWay API tools for instant PCB manufacturing quotes, SMT assembly pricing, order management, and shipping costs.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pcbway-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pcbway",
    "mcp",
    "model context protocol",
    "pcbway api",
    "pcb quote",
    "smt assembly",
    "pcb",
    "pcba",
    "manufacturing",
    "electronics",
    "hardware",
    "pcb assembly",
    "pcb manufacturing",
    "prototyping",
    "supply chain"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nabheet/pcbway-mcp-server.git"
  },
  "homepage": "https://github.com/nabheet/pcbway-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/nabheet/pcbway-mcp-server/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^18.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
